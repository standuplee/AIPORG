# AIPORG API 키 템플릿
# 이 파일을 복사해서 .env 로 만든 뒤 값을 채우세요:  cp .env.example .env
# .env 는 .gitignore 에 포함되어 git 에 올라가지 않습니다.
# 필요한 키만 채우면 되고, 비어 있는 수집기는 자동으로 제외(degrade)됩니다.

# =============================================================
# AIPORG 1.0 (aiporg/) — 접두사 없는 이름. aiporg/env.py 가 직접 읽는다.
# =============================================================

# --- 네이버 검색 API (뉴스 + 블로그) — https://developers.naver.com ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 카카오 다음 검색 API (뉴스) — https://developers.kakao.com (REST API 키) ---
KAKAO_REST_API_KEY=

# --- 유튜브 Data API v3 — https://console.cloud.google.com (YouTube Data API 사용 설정) ---
YOUTUBE_API_KEY=

# --- X(트위터) API v2 Bearer Token — https://developer.x.com ---
X_BEARER_TOKEN=

# --- 인스타그램 그래프 API (비즈니스 계정) — https://developers.facebook.com ---
IG_ACCESS_TOKEN=

# --- LLM 서술 엔진 (선택: config 의 llm.provider 를 gemini/openai 로 바꿀 때) ---
# Gemini 2.5 Pro — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenAI GPT-5 — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# =============================================================
# AIPORG 2.0 (app/, streamlit_app/console.py) — AIPORG2_ 접두사 필수.
# app/core/config.py 의 Settings.from_env() 는 이 접두사가 붙은 이름만
# 읽는다(1.0 환경을 건드리지 않기 위한 의도적 분리). 값은 위 1.0 키와
# 같은 발급 키를 그대로 복사해 넣으면 된다 — 그냥 같은 값을 두 번 쓰는
# 것뿐, 1.0 설정을 2.0이 자동으로 읽어주지는 않는다.
# streamlit_app/console.py 가 python-dotenv 로 이 파일을 로드하므로
# 쉘에서 따로 export 할 필요는 없다. 단, get_settings() 가 프로세스당
# 한 번만 읽으므로 .env 를 고친 뒤에는 `streamlit run`을 재시작해야 한다.
# =============================================================

# --- 네이버(2.0 collector, 위 NAVER_CLIENT_ID/SECRET 과 같은 값) ---
AIPORG2_NAVER_CLIENT_ID=
AIPORG2_NAVER_CLIENT_SECRET=

# --- 다음/카카오(2.0 collector, 위 KAKAO_REST_API_KEY 와 같은 값) ---
AIPORG2_KAKAO_REST_API_KEY=

# --- 아래는 선택 사항. 비워두면 app/core/config.py 의 기본값을 쓴다 ---
# AIPORG2_DATABASE_URL=sqlite:///aiporg2.db
# AIPORG2_ENVIRONMENT=development
# AIPORG2_LOG_LEVEL=INFO
