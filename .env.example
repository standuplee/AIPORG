# AIPORG API 키 템플릿
# 이 파일을 복사해서 .env 로 만든 뒤 값을 채우세요:  cp .env.example .env
# .env 는 .gitignore 에 포함되어 git 에 올라가지 않습니다.
# 필요한 키만 채우면 되고, 비어 있는 수집기는 자동으로 제외(degrade)됩니다.

# --- 네이버 검색 API (뉴스 + 블로그) — https://developers.naver.com ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 유튜브 Data API v3 — https://console.cloud.google.com (YouTube Data API 사용 설정) ---
YOUTUBE_API_KEY=

# --- X(트위터) API v2 Bearer Token — https://developer.x.com ---
X_BEARER_TOKEN=

# --- 인스타그램 그래프 API (비즈니스 계정) — https://developers.facebook.com ---
IG_ACCESS_TOKEN=

# --- LLM 서술 엔진 (선택: config 의 llm.provider 를 gemini/openai 로 바꿀 때) ---
# Gemini 2.5 Pro — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenAI GPT-5 — https://platform.openai.com/api-keys
OPENAI_API_KEY=
